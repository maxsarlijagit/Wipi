{
  "name": "wipi",
  "version": "0.3.0",
  "description": "A calm notification bar for Windows",
  "main": "src/main.js",
  "author": "Wipi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.wipi.app",
    "productName": "Wipi",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "scripts", "to": "scripts", "filter": ["*.js", "*.ps1"] },
      { "from": "chatgpt-extension", "to": "chatgpt-extension" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "assets/wipi.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
