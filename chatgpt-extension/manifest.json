{
  "manifest_version": 3,
  "name": "Wipi para ChatGPT",
  "version": "0.1.0",
  "description": "Avisa a Wipi cuando ChatGPT web termina una respuesta.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:47823/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Wipi para ChatGPT", "default_popup": "popup.html" }
}
